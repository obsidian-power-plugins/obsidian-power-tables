{
	"name": "powertables",
	"version": "1.52.0",
	"description": "Obsidian plugin: color, calculate, and sort Markdown tables in place, with everything stored as plain Markdown",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "esbuild tests/tests.ts --bundle --format=cjs --outfile=tests.cjs && node tests.cjs",
		"deploy": "npm run build && node deploy.mjs"
	},
	"devDependencies": {
		"@codemirror/state": "6.7.1",
		"@codemirror/view": "6.43.6",
		"@types/node": "20.19.43",
		"esbuild": "0.21.5",
		"obsidian": "1.13.1",
		"tslib": "2.8.1",
		"typescript": "5.9.3"
	}
}
