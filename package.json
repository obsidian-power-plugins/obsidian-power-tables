{
	"name": "powertables",
	"version": "1.20.7",
	"description": "Obsidian plugin: color, calculate, and sort Markdown tables in place, with everything stored as plain Markdown",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "esbuild src/tests.ts --bundle --format=cjs --outfile=tests.cjs && node tests.cjs",
		"deploy": "npm run build && node deploy.mjs"
	},
	"devDependencies": {
		"@codemirror/state": "^6.4.1",
		"@codemirror/view": "^6.26.3",
		"@types/node": "^20.14.0",
		"esbuild": "^0.21.5",
		"obsidian": "latest",
		"tslib": "^2.6.3",
		"typescript": "^5.5.3"
	}
}
